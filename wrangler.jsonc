{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rafaelloubaque-solo-regular-lp",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"],
    },
  ],
}
